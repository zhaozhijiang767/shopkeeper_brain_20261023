# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-ws-H.YMHMYHL.HHEC.MEUCID0Dn39XCpBLM11qdm0cIFrKZGHU2AAiYwcUkmEtWOYdAiEAqU3GP7-RaIiCskHZBTe02HPm9V17JcWPmwLgV-AXTJ0
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://ws-8m0ns9w20tc9i1ra.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=deepseek-v4-flash-0731
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=deepseek-v4-flash-0731
# 商品名识别模型
ITEM_MODEL=deepseek-v4-flash-0731
# 知识图谱抽取模型
KG_MODEL=deepseek-v4-flash-0731

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cpu
# 是否使用半精度（True/False）
BGE_FP16=False
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cpu
# 重排序模型半精度
BGE_RERANKER_FP16=0

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 实体名称集合名
ENTITY_NAME_COLLECTION=kb_graph_entity_names
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Graph Database (Neo4j)
# ====================
# Neo4j 连接 URI
NEO4J_URI=bolt://localhost:7687
# 数据库名（社区版固定为 neo4j）
NEO4J_DATABASE=neo4j
# 用户名
NEO4J_USERNAME=neo4j
# 密码（必须与 neo4j 容器的 NEO4J_AUTH 一致，之前这里是占位符 your_password 导致认证失败）
NEO4J_PASSWORD=hzk123456

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage（RustFS，S3 协议对象存储）
# ====================
# 注意：docker-compose.yml 里 rustfs 容器的 RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY
# 才是实际生效的凭据（当前为 rustfs/rustfs），下面必须与它保持一致，否则报 403 InvalidAccessKeyId。
# 服务端点（API 端口 9000）
RUSTFS_ENDPOINT=localhost:9000
# 访问密钥
RUSTFS_ACCESS_KEY=rustfs
# 私有密钥
RUSTFS_SECRET_KEY=rustfs
# 区域
RUSTFS_REGION=us-east-1
# 存储桶名称（不存在时连接仍算通过，但首次上传前需先建桶）
RUSTFS_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp